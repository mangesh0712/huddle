APP_NAME=Huddle
INVITE_KEY=            # random; python -c "import secrets; print(secrets.token_urlsafe(16))"
ADMIN_KEY=             # random, different from INVITE_KEY
SESSION_SECRET=        # random, 32+ bytes
CHANNELS=Lounge,Chill,Gaming,Karaoke   # channels named in KARAOKE_CHANNELS never duck the music and open lyrics
LIVEKIT_URL=wss://<project>.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
YOUTUBE_API_KEY=
SKIP_POLICY=anyone     # anyone | admin | majority
ALLOWED_ORIGINS=       # only needed if the frontend is served from another origin
KARAOKE_CHANNELS=Karaoke
